# --- общие ---
BASE_DOMAIN=localhost            # в проде: example.com  → адреса вида <id>.dns.example.com
ACME_EMAIL=admin@example.com
CADDYFILE=./deploy/caddy/Caddyfile.dev   # в проде: ./deploy/caddy/Caddyfile.prod
CLOUDFLARE_API_TOKEN=            # только для wildcard в проде (права Zone:DNS:Edit)
DNS_PUBLIC_PORT=5353             # локально 5353 (порт 53 обычно занят); на VPS — 53

# --- Postgres / Redis ---
POSTGRES_USER=shield
POSTGRES_PASSWORD=change_me
POSTGRES_DB=shielddns
# Для запуска Go на хосте (go run): 
DATABASE_URL=postgres://shield:change_me@localhost:5432/shielddns?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# --- приложение ---
JWT_SECRET=change_me_openssl_rand_hex_32
UPSTREAMS=1.1.1.1:53,8.8.8.8:53
STATS_FLUSH_SECONDS=4
BLOCKLIST_REFRESH_HOURS=24
ALLOW_ANON_DEFAULT=true          # обычный DNS без привязки получает профиль «реклама+вредоносные»; в проде поставьте false
DEFAULT_CLIENT_ID=               # или укажите client_id профиля для обычного DNS
# Для запуска DNS на хосте без root:
DNS_UDP_ADDR=:5353
DOT_ADDR=:8853
DOH_ADDR=:8053
